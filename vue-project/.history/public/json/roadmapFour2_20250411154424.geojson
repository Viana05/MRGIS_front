            },
            "properties": {
                "OBJECTID": 6,
                "Image": "海蚀穴",
                "Latitude": 34.700244444444451,
                "Longitude": 119.48383611111112,
                "Detail": "在海浪的长期冲击和侵蚀作用下，沿着岩石的节理、层理等抗蚀力相对薄弱的部位逐渐形成海蚀穴。与海蚀洞不同，海蚀穴尚未形成深入的洞穴结构，但其存在预示着海蚀地貌的进一步发展。"
            }
        },
