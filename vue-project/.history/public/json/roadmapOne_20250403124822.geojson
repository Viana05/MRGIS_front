                ]
            },
            "properties": {
                "OBJECTID": 4,
                "Image": "测量褶曲产状",
                "Latitude": 34.232897219999998,
                "Longitude": 117.10790280000001,
                "Detail": "用罗盘测量核部两侧馒头组下部灰岩的岩层产状并分析，可知尖山背斜为倾斜褶曲且轴面产状为向东南方向倾斜。"
            }
        },
        {
