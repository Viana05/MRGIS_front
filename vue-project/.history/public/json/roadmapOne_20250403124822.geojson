                ]
            },
            "properties": {
                "OBJECTID": 6,
                "Image": "石灰岩",
                "Latitude": 34.233480559999997,
                "Longitude": 117.10827500000001,
                "Detail": "石灰岩在猴家山组出露较好，呈灰黄色，具水平层理。该岩石在海里形成，经过连续沉积，呈现灰黄色原因是由泥质掺杂，结晶过程好。"
            }
        },
        {
