            },
            "properties": {
                "OBJECTID": 3,
                "Image": "方解石",
                "Latitude": 34.233411109999999,
                "Longitude": 117.1081167,
                "Detail": "方解石呈半透明白色，玻璃光泽，为晶体的集合体。石灰岩形成面粗糙不平、延伸不远的张节理后，沉积结晶形成方解石。"
            }
        },
